{
  "name": "@fajekrina/sdui",
  "version": "0.6.1",
  "description": "SDUI engine on the murti-derived spec: one headless engine (MurtiEngine structure), generic React/Vue/vanilla renderers, native-bridge ports for Android/iOS WebView hosts. No Tailwind/Bootstrap bundled.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fajekrina/sdui.git"
  },
  "bugs": {
    "url": "https://github.com/fajekrina/sdui/issues"
  },
  "homepage": "https://github.com/fajekrina/sdui#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser/index.d.ts",
        "default": "./dist/browser/index.js"
      },
      "require": {
        "types": "./dist/browser/index.d.cts",
        "default": "./dist/browser/index.cjs"
      }
    },
    "./bridge": {
      "import": {
        "types": "./dist/bridge/index.d.ts",
        "default": "./dist/bridge/index.js"
      },
      "require": {
        "types": "./dist/bridge/index.d.cts",
        "default": "./dist/bridge/index.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat/index.d.ts",
        "default": "./dist/compat/index.js"
      },
      "require": {
        "types": "./dist/compat/index.d.cts",
        "default": "./dist/compat/index.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/i18n/index.d.ts",
        "default": "./dist/i18n/index.js"
      },
      "require": {
        "types": "./dist/i18n/index.d.cts",
        "default": "./dist/i18n/index.cjs"
      }
    },
    "./pwa": {
      "import": {
        "types": "./dist/pwa/index.d.ts",
        "default": "./dist/pwa/index.js"
      },
      "require": {
        "types": "./dist/pwa/index.d.cts",
        "default": "./dist/pwa/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.ts",
        "default": "./dist/vue/index.js"
      },
      "require": {
        "types": "./dist/vue/index.d.cts",
        "default": "./dist/vue/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla/index.d.ts",
        "default": "./dist/vanilla/index.js"
      },
      "require": {
        "types": "./dist/vanilla/index.d.cts",
        "default": "./dist/vanilla/index.cjs"
      }
    },
    "./builder": {
      "import": {
        "types": "./dist/builder/index.d.ts",
        "default": "./dist/builder/index.js"
      },
      "require": {
        "types": "./dist/builder/index.d.cts",
        "default": "./dist/builder/index.cjs"
      }
    },
    "./builder/react": {
      "import": {
        "types": "./dist/builder/react.d.ts",
        "default": "./dist/builder/react.js"
      },
      "require": {
        "types": "./dist/builder/react.d.cts",
        "default": "./dist/builder/react.cjs"
      }
    },
    "./builder/vue": {
      "import": {
        "types": "./dist/builder/vue.d.ts",
        "default": "./dist/builder/vue.js"
      },
      "require": {
        "types": "./dist/builder/vue.d.cts",
        "default": "./dist/builder/vue.cjs"
      }
    },
    "./builder/studio.css": "./dist/builder/studio.css",
    "./spec/*": "./spec/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist",
    "spec",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "agnostic",
    "headless",
    "murti",
    "native-bridge",
    "react",
    "sdui",
    "server-driven-ui",
    "vanilla",
    "vue",
    "webview"
  ],
  "scripts": {
    "build": "vite build && node scripts/dts-formats.mjs && node scripts/studio-css.mjs",
    "prepare": "npm run build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "lint:spec": "vitest run tests/spec.test.ts",
    "size": "node scripts/size.mjs",
    "sign-bundle": "node scripts/sign-bundle.mjs",
    "conformance": "playwright test",
    "test:contract": "vitest run tests/contract.e2e.test.ts",
    "check:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "ajv": "^8.17.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^31.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^5.1.0",
    "vue": "^3.4.0"
  }
}
