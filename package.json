{
  "name": "@fajekrina/sdui",
  "version": "0.1.0",
  "description": "Fajekrina SDUI — Universal agnostic renderer (React/Vue/Vanilla) for Universal SDUI JSON. No Tailwind/Bootstrap bundled.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fajekrina/sdui"
  },
  "bugs": {
    "url": "https://github.com/fajekrina/sdui/issues"
  },
  "homepage": "https://github.com/fajekrina/sdui#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js",
      "require": "./dist/vue/index.cjs"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.js",
      "require": "./dist/builder/index.cjs"
    },
    "./builder/react": {
      "types": "./dist/builder/react.d.ts",
      "import": "./dist/builder/react.js",
      "require": "./dist/builder/react.cjs"
    },
    "./builder/vue": {
      "types": "./dist/builder/vue.d.ts",
      "import": "./dist/builder/vue.js",
      "require": "./dist/builder/vue.cjs"
    }
  },
  "main": "./dist/core/index.cjs",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": ["sdui", "server-driven-ui", "react", "vue", "agnostic"],
  "scripts": {
    "build": "vite build",
    "prepare": "npm run build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "vue": "^3.3.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vue": { "optional": true }
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "vue": "^3.4.0",
    "@vitejs/plugin-vue": "^5.0.0"
  }
}
